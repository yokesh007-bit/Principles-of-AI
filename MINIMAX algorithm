# Minimax Adversarial Search Algorithm for Tic-Tac-Toe
PLAYER_X = 1    # Maximizing agent (AI)
PLAYER_O = -1   # Minimizing agent (Opponent)
EMPTY = 0

def evaluate(board):
    # Check rows, columns, and diagonals
    for row in range(3):
        if board[row][0] == board[row][1] == board[row][2] != EMPTY:
            return board[row][0]
    for col in range(3):
        if board[0][col] == board[1][col] == board[2][col] != EMPTY:
            return board[0][col]
    if board[0][0] == board[1][1] == board[2][2] != EMPTY:
        return board[0][0]
    if board[0][2] == board[1][1] == board[2][0] != EMPTY:
        return board[0][2]
    return 0

def isMovesLeft(board):
    for r in range(3):
        for c in range(3):
            if board[r][c] == EMPTY:
                return True
    return False

def minimax(board, isMax):
    score = evaluate(board)
    if score != 0:
        return score
    if not isMovesLeft(board):
        return 0

    if isMax:
        best = -float('inf')
        for r in range(3):
            for c in range(3):
                if board[r][c] == EMPTY:
                    board[r][c] = PLAYER_X
                    best = max(best, minimax(board, not isMax))
                    board[r][c] = EMPTY
        return best
    else:
        best = float('inf')
        for r in range(3):
            for c in range(3):
                if board[r][c] == EMPTY:
                    board[r][c] = PLAYER_O
                    best = min(best, minimax(board, not isMax))
                    board[r][c] = EMPTY
        return best

def findBestMove(board):
    bestVal = -float('inf')
    bestMove = (-1, -1)
    for r in range(3):
        for c in range(3):
            if board[r][c] == EMPTY:
                board[r][c] = PLAYER_X
                moveVal = minimax(board, False)
                board[r][c] = EMPTY
                if moveVal > bestVal:
                    bestMove = (r, c)
                    bestVal = moveVal
    return bestMove

def printBoard(board):
    symbols = {PLAYER_X: "X", PLAYER_O: "O", EMPTY: "."}
    for row in board:
        print("  " + " ".join([symbols[cell] for cell in row]))

# Demonstration game board state
board = [
    [PLAYER_X, PLAYER_O, PLAYER_X],
    [PLAYER_O, PLAYER_X, EMPTY],
    [EMPTY, PLAYER_O, EMPTY]
]

print("Current Game Board:")
printBoard(board)

best_move = findBestMove(board)
print(f"\nMinimax Evaluated Best Move for Player X: {best_move}")
board[best_move[0]][best_move[1]] = PLAYER_X

print("\nBoard After Optimal Move:")
printBoard(board)
